def row7 (j : Fin 35) : Pauli 56 := (l7[j.val]?).getD Pauli.zero

theorem rows_mem7 : ∀ j, row7 j ∈ l7 := by decide
theorem bind_x7 : ∀ (i : Fin 56) (j : Fin 35), (xc7 i).getLsbD j = (row7 j).z.getLsbD i := by decide
theorem bind_z7 : ∀ (i : Fin 56) (j : Fin 35), (zc7 i).getLsbD j = (row7 j).x.getLsbD i := by decide
theorem zero_allowed7 : allowed7 0 = true := by decide
theorem single_allowed7 : ∀ (i : Fin 56) (a : Fin 3), allowed7 (axiscol xc7 zc7 i a) = true := by decide
theorem single_nonzero7 : ∀ (i : Fin 56) (a : Fin 3), axiscol xc7 zc7 i a ≠ 0 := by decide


